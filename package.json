{
	"name": "linkpeek",
	"version": "2.1.7",
	"description": "Fast, safe link preview and Open Graph scraper. Unfurl URL metadata in TypeScript, Node.js, Bun, Deno and edge.",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"packageManager": "npm@11.21.1",
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"benchmark": "npm run build --silent && node scripts/benchmark.mjs",
		"benchmark:live": "npm run build --silent && LINKPEEK_LIVE_TESTS=1 node scripts/benchmark.mjs --live",
		"docs:build": "npm run build --prefix website",
		"docs:dev": "npm run dev --prefix website",
		"downloads": "node scripts/downloads.mjs",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:live": "LINKPEEK_LIVE_TESTS=1 vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"audit": "npm audit --omit=dev && npm audit --audit-level=high && npm audit --prefix benchmarks/competitive --package-lock-only",
		"package:check": "npm run build --silent && node test/package-smoke.mjs && publint && attw --pack . && npm pack --dry-run",
		"publish:check": "npm run lint && npm run typecheck && npm run test && npm run audit && npm run build --silent",
		"quality": "npm run lint && npm run typecheck && npm run test && npm run audit && npm run package:check",
		"typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
		"prepublishOnly": "npm run publish:check",
		"release": "release-it"
	},
	"keywords": [
		"link-preview",
		"url-preview",
		"preview-card",
		"link-unfurl",
		"link-unfurling",
		"unfurl",
		"open-graph",
		"opengraph",
		"open-graph-scraper",
		"open-graph-parser",
		"og",
		"ogp",
		"og-tags",
		"twitter-card",
		"meta-tags",
		"json-ld",
		"oembed",
		"url-metadata",
		"link-metadata",
		"metadata",
		"scraper",
		"typescript",
		"nodejs",
		"edge-runtime",
		"cloudflare-workers",
		"bun",
		"deno",
		"ssrf"
	],
	"author": "Adrian Gruber",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thegruber/linkpeek.git"
	},
	"homepage": "https://linkpeek.js.org/",
	"bugs": {
		"url": "https://github.com/thegruber/linkpeek/issues"
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"fsevents@2.3.3": true
	},
	"dependencies": {
		"htmlparser2": "^12.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.6.8",
		"@release-it/conventional-changelog": "^12.0.2",
		"@types/node": "^22.20.5",
		"@vitest/coverage-v8": "^5.1.0",
		"publint": "^0.3.25",
		"release-it": "^21.1.2",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	},
	"overrides": {
		"get-uri": {
			"basic-ftp": "^6.2.6"
		},
		"release-it": {
			"undici": "^7.30.1"
		}
	}
}
