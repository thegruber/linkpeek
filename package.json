{
	"name": "linkpeek",
	"version": "2.0.0",
	"description": "Lightweight, secure link preview and URL metadata extractor for Open Graph, Twitter Cards, JSON-LD, and edge runtimes.",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"llms.txt"
	],
	"packageManager": "npm@11.12.1",
	"sideEffects": false,
	"scripts": {
		"build": "tsup",
		"benchmark": "npm run build --silent && node scripts/benchmark.mjs",
		"benchmark:live": "npm run build --silent && LINKPEEK_LIVE_TESTS=1 node scripts/benchmark.mjs --live",
		"test": "vitest run",
		"test:live": "LINKPEEK_LIVE_TESTS=1 vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"package:check": "npm run build --silent && publint && attw --pack . && npm pack --dry-run",
		"publish:check": "npm run lint && npm run typecheck && npm run test && npm audit && npm run build --silent",
		"quality": "npm run lint && npm run typecheck && npm run test && npm audit && npm run package:check",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run publish:check"
	},
	"keywords": [
		"link-preview",
		"link preview",
		"url preview",
		"open graph",
		"open-graph",
		"opengraph",
		"og",
		"ogp",
		"twitter card",
		"twitter-cards",
		"json-ld",
		"jsonld",
		"metadata",
		"meta tags",
		"unfurl",
		"url metadata",
		"scraper",
		"parser",
		"extractor",
		"oembed",
		"html",
		"metadata extraction",
		"metadata extractor",
		"metadata-extractor",
		"extract-metadata",
		"meta-tags",
		"open graph scraper",
		"og scraper",
		"node",
		"nodejs",
		"bun",
		"deno",
		"typescript",
		"cloudflare-workers",
		"ssrf",
		"security",
		"link unfurl",
		"url unfurl",
		"preview card",
		"social preview",
		"edge runtime",
		"cloudflare worker"
	],
	"author": "Adrian Gruber",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thegruber/linkpeek.git"
	},
	"homepage": "https://github.com/thegruber/linkpeek#readme",
	"bugs": {
		"url": "https://github.com/thegruber/linkpeek/issues"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"dependencies": {
		"htmlparser2": "^12.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.3",
		"@biomejs/biome": "^2.4.16",
		"publint": "^0.3.21",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"vitest": "^4.1.8"
	}
}
