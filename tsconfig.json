{
	// Type-checking only — tsup owns all emit (see tsup.config.ts).
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		// Silence TS 6.0 deprecation warnings from defaults we do not set ourselves.
		"ignoreDeprecations": "6.0"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "test"]
}
