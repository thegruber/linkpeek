{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"declaration": false,
		"declarationMap": false,
		"sourceMap": false,
		"outDir": null,
		"rootDir": ".",
		"paths": { "linkpeek": ["./src/index.ts"] },
		"types": ["node"]
	},
	"include": [
		"src",
		"test",
		"website/demo.ts",
		"website/downloads.ts",
		"website/downloads-data.ts",
		"website/site.ts"
	],
	"exclude": ["node_modules", "dist", "test/bun-smoke.ts", "test/deno-smoke.ts"]
}
